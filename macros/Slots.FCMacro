
__title__ = "Create parallel slots in selected horizontal face"
__doc__ = "Select face and run macro"
__url__ = "https://forum.freecad.org/viewtopic.php?t=107631"

import math

import FreeCAD
import FreeCADGui
import Part
from FreeCAD import Vector
from numpy import linspace

angle = 0            # 0 - slots along X, 90 - solts along Y

connect_gap = 5      # connect slot if gap less than this value
exclude_shorter = 2  # skip slot with length shorter than this value

outer_offset = 2     # offset from bosses and holes
slot_depth = 2       # slot depth
slot_width = 2       # slot width
slot_step = 2        # minimal distance between slots

offset_left_x = slot_width  # offset x for left side
offset_right_x = slot_width  # offset x for right side

offset_top_y = -2  # offset y for top side (positive value increase area)
offset_bottom_y = -2  # offset y for bottom side (positive value increase area)

"""
                            top
                     p3--------------p2
       ^               |  --------  |
       |         left  |  --------  |  right
     y |               |  --------  |
       |             p0--------------p1
        ------>            bottom
          x
"""

def getExtFace(face):
    """getExtFace(face) ... return rectangular face extended along X and Y"""
    fbb = face.BoundBox

    p0 = fbb.getPoint(0)
    p0.x -= offset_left_x
    p0.y -= offset_bottom_y
    p1 = fbb.getPoint(1)
    p1.x += offset_right_x
    p1.y -= offset_bottom_y
    p2 = fbb.getPoint(2)
    p2.x += offset_right_x
    p2.y += offset_top_y
    p3 = fbb.getPoint(3)
    p3.x -= offset_left_x
    p3.y += offset_top_y

    e1 = Part.makeLine(p0, p1)
    e2 = Part.makeLine(p1, p2)
    e3 = Part.makeLine(p2, p3)
    e4 = Part.makeLine(p3, p0)

    ext_wire = Part.Wire([e1, e2, e3, e4])

    return Part.Face(ext_wire)


def getHoles(face):
    """getHoles(face) ... return inner faces with offset"""
    outer_wire = face.OuterWire
    outer_index = [w.hashCode() for w in face.Wires].index(outer_wire.hashCode())

    inner_wires = face.Wires
    del inner_wires[outer_index]

    holes = []
    for w in inner_wires:
        o1 = Part.Face(w.makeOffset2D(outer_offset))
        o2 = Part.Face(w.makeOffset2D(-outer_offset))
        if o1.Area > o2.Area:
            holes.append(o1)
        else:
            holes.append(o2)

    return holes


def makeSlot(edge):
    """makeSlot(edge) ... return slot (solid) from center edge or wire"""
    r = slot_width / 2  # arcs radius
    p1 = edge.Vertexes[0].Point
    p2 = edge.Vertexes[1].Point

    e1 = Part.makeLine(Vector(p1.x, p1.y - r, p1.z), Vector(p2.x, p2.y - r, p2.z))

    # right arc
    arc = Part.Arc(Vector(p2.x, p2.y - r, p2.z), Vector(p2.x + r, p2.y, p2.z), Vector(p2.x, p2.y + r, p2.z))
    e2 = Part.Edge(arc)

    e3 = Part.makeLine(Vector(p2.x, p2.y + r, p2.z), Vector(p1.x, p1.y + r, p1.z))

    # left arc
    arc = Part.Arc(Vector(p1.x, p1.y + r, p1.z), Vector(p1.x - r, p1.y, p1.z), Vector(p1.x, p1.y - r, p1.z))
    e4 = Part.Edge(arc)

    return Part.Face(Part.Wire([e1, e2, e3, e4])).extrude(Vector(0, 0, -slot_depth))


def processLine(line, holes):
    """processLine(line, holes) ... return wire without intersection with holes"""
    edges = Part.Wire(line).cut(holes).Edges

    edges = sorted(edges, key=lambda e: e.Vertexes[0].X)
    result = []
    for i in range(len(edges) - 1):
        if edges[i].distToShape(edges[i + 1])[0] <= connect_gap:
            edges[i + 1] = combineEdges(edges[i], edges[i + 1])
        else:
            result.append(Part.Wire(edges[i]))
    result.append(Part.Wire(edges[-1]))

    return [w for w in result if w.Length >= exclude_shorter]


def combineEdges(edge1, edge2):
    """combineEdges(edge1, edge2) ... return edge which is sum of two edges"""
    ps = [v.Point for e in (edge1, edge2) for v in e.Vertexes]
    grouped_points = ((ps[0], ps[2]), (ps[0], ps[3]), (ps[1], ps[2]), (ps[1], ps[3]))
    p0, p1 = max(grouped_points, key=lambda g: (g[1] - g[0]).Length)

    return Part.makeLine(p0, p1)


print()
print("<<< Macro create parallel slots in selected horizontal face >>>")
print()

FreeCAD.ActiveDocument.openTransaction("Slots")  # allows to undo

for sel in FreeCADGui.Selection.getSelectionEx():
    obj = sel.Object
    shape = sel.Object.Shape.rotated(Vector(0,0,0), Vector(0,0,1), angle)
    face = sel.SubObjects[0].rotated(Vector(0,0,0), Vector(0,0,1), angle)  # selected face
    if not isinstance(face, Part.Face):
        continue

    # rectangular face extended along X
    ext_face = getExtFace(face)
    # Part.show(ext_face, "ext_face")

    # negative offset from inner wires to not intersects with holes
    holes = getHoles(face)
    # Part.show(Part.Compound(holes), "holes")

    # slots number
    width = ext_face.Edges[1].Length
    nr = math.ceil((width - slot_width)/ (slot_step + slot_width)) + 1

    start_x = ext_face.Edges[0].Vertexes[0].Point.x
    end_x = ext_face.Edges[0].Vertexes[1].Point.x
    start_y = ext_face.Edges[1].Vertexes[0].Point.y + slot_width / 2
    end_y = ext_face.Edges[1].Vertexes[1].Point.y - slot_width / 2
    positions = linspace(start_y, end_y, nr)  # positions slots along Y
    print("  slots number", len(positions))
    print("  slots positions", [round(float(y), 2) for y in positions])

    z = ext_face.Edges[0].Vertexes[0].Point.z

    lines = [Part.makeLine(Vector(start_x, y, z), Vector(end_x, y, z)) for y in positions]
    # Part.show(Part.Compound(lines), "lines")

    cwires = [w for line in lines for w in processLine(line, holes)]
    # Part.show(Part.Compound(cwires), "cwires")

    slots = [makeSlot(w) for w in cwires]
    # Part.show(Part.Compound(slots), "slots")

    cut_model = shape.cut(slots)
    cut_model.rotate(Vector(0, 0, 0), Vector(0, 0, 1), -angle)

    obj.ViewObject.Visibility = False

    obj_slot = Part.show(cut_model, f"{obj.Label}_Slots")

FreeCAD.ActiveDocument.commitTransaction()  # allows to undo
