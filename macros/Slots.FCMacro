
__title__ = "Create parallel slots in selected horizontal face"
__doc__ = ""
__url__ = "https://forum.freecad.org/viewtopic.php?t=107631"

import math

import FreeCADGui
import Part
from FreeCAD import Vector
from numpy import linspace

outer_offset = 2  # offset from outer wire, bosses and holes
slot_depth = 2    # slot depth
slot_width = 2    # slot width
slot_step = 2     # minimal distance between slots

offset_left_x = 2 * slot_width + outer_offset  # offset x for left side
offset_right_x = 2 * slot_width + outer_offset  # offset x for right side

offset_top_y = 0  # offset y for top side (positive value increase area)
offset_bottom_y = 0  # offset y for bottom side (positive value increase area)

"""
                top
         p3--------------p2
           |            |
           |  --------  |
   left    |  --------  |     right
           |            |
         p0--------------p1
               bottom
"""


def getExtFace(face):
    """getExtFace(face) ... return rectangular face extended along X"""
    fbb = face.BoundBox

    p0 = fbb.getPoint(0)
    p0.x -= offset_left_x
    p0.y -= offset_bottom_y
    p1 = fbb.getPoint(1)
    p1.x += offset_right_x
    p1.y -= offset_bottom_y
    p2 = fbb.getPoint(2)
    p2.x += offset_right_x
    p2.y += offset_top_y
    p3 = fbb.getPoint(3)
    p3.x -= offset_left_x
    p3.y += offset_top_y

    e1 = Part.makeLine(p0, p1)
    e2 = Part.makeLine(p1, p2)
    e3 = Part.makeLine(p2, p3)
    e4 = Part.makeLine(p3, p0)

    ext_wire = Part.Wire([e1, e2, e3, e4])
    wires = [ext_wire] + getInnerWires(face)
    ext_face = Part.makeFace(wires, "Part::FaceMakerBullseye")

    return ext_face


def getInnerWires(face):
    """getInnerWires(face) ... return inner wires of face"""
    outer_wire = face.OuterWire
    outer_index = [w.hashCode() for w in face.Wires].index(outer_wire.hashCode())

    inner_wires = face.Wires
    del inner_wires[outer_index]

    return inner_wires


def makeSlot(edge):
    """makeSlot(edge) ... return slot (solid) from center edge or wire"""
    r = slot_width / 2
    p1 = edge.Vertexes[0].Point
    p2 = edge.Vertexes[1].Point

    e1 = Part.makeLine(Vector(p1.x, p1.y - r, p1.z), Vector(p2.x, p2.y - r, p2.z))
    e2 = Part.Edge(Part.Arc(Vector(p2.x, p2.y - r, p2.z), Vector(p2.x + r, p2.y, p2.z), Vector(p2.x, p2.y + r, p2.z)))
    e3 = Part.makeLine(Vector(p2.x, p2.y + r, p2.z), Vector(p1.x, p1.y + r, p1.z))
    e4 = Part.Edge(Part.Arc(Vector(p1.x, p1.y + r, p1.z), Vector(p1.x - r, p1.y, p1.z), Vector(p1.x, p1.y - r, p1.z)))

    return Part.Face(Part.Wire([e1, e2, e3, e4])).extrude(Vector(0, 0, -slot_depth))


for sel in FreeCADGui.Selection.getSelectionEx():
    obj = sel.Object
    face = sel.SubObjects[0]
    if not isinstance(face, Part.Face):
        continue

    ext_face = getExtFace(face)
    # Part.show(ext_face, "ext_face1")
    ext_face = ext_face.makeOffset2D(-outer_offset - slot_width / 2)
    # Part.show(ext_face, "ext_face2")
    length = ext_face.Edges[0].Length
    width = ext_face.Edges[1].Length

    nr = math.ceil((width - slot_width)/ (slot_step + slot_width)) + 1

    start_x = ext_face.Edges[0].Vertexes[0].Point.x
    end_x = ext_face.Edges[0].Vertexes[1].Point.x

    start_y = ext_face.Edges[1].Vertexes[0].Point.y + slot_width / 2
    end_y = ext_face.Edges[1].Vertexes[1].Point.y - slot_width / 2
    placement = linspace(start_y, end_y, nr - slot_step)
    print("slots placement", placement)

    z = ext_face.Edges[0].Vertexes[0].Point.z
    wires = [Part.Wire(Part.makeLine(Vector(start_x, y, z), Vector(end_x, y, z))) for y in placement]
    holes = [Part.Face(w) for w in getInnerWires(ext_face)]
    cwires = [cw for w in wires for cw in w.cut(holes).Wires]
    slots = [makeSlot(w) for w in cwires]

    cut_model = obj.Shape.cut(slots)

    obj.ViewObject.Visibility = False
    Part.show(cut_model, "Slots")
